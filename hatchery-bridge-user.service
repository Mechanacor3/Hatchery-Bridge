[Unit]
Description=Hatchery Bridge outbound MCP tunnel
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/ssd/workspace/hatchery-bridge
Environment=HOME=/home/molt
LoadCredential=tunnel-key:%h/.config/hatchery-bridge/tunnel-key
ExecStart=/bin/bash /ssd/workspace/hatchery-bridge/user-service-run.sh
Restart=always
RestartSec=5
UMask=0077
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=default.target
